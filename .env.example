# ============================================================
# AgentOS — Environment Configuration
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# Ollama
OLLAMA_HOST=http://localhost:11434

# Models (default selections)
DEFAULT_MODEL=llama3
CODING_MODEL=deepseek-coder
CONVERSATION_MODEL=mistral

# Memory
CHROMA_HOST=http://localhost:8000
SQLITE_PATH=./data/agentos.db

# Logging
LOG_LEVEL=debug
