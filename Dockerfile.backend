FROM node:22-alpine AS base

# ─── Backend Builder ────────────────────────────────────────
FROM base AS backend-deps
WORKDIR /app
COPY services/ai-backend/package.json ./services/ai-backend/
COPY packages/types/package.json ./packages/types/
COPY package.json package-lock.json ./
RUN npm ci --workspace=@agentos/ai-backend

FROM base AS backend
WORKDIR /app
COPY --from=backend-deps /app/node_modules ./node_modules
COPY --from=backend-deps /app/services/ai-backend/node_modules ./services/ai-backend/node_modules
COPY services/ai-backend ./services/ai-backend
COPY packages/types ./packages/types
RUN mkdir -p services/ai-backend/workspace
EXPOSE 4000
ENV NODE_ENV=production
CMD ["npx", "tsx", "services/ai-backend/src/index.ts"]
